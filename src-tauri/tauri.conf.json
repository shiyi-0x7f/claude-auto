{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Auto",
  "version": "0.1.0",
  "identifier": "com.shiyi.claudeauto",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Claude Auto Widget",
        "url": "index.html#/widget",
        "width": 360,
        "height": 186,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "Claude Auto",
        "url": "index.html#/settings",
        "width": 1040,
        "height": 740,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
